# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (Docker Postgres) ─────────────────────────────────────────────
POSTGRES_USER=eskista
POSTGRES_PASSWORD=eskista_dev_pw
POSTGRES_DB=eskista
POSTGRES_PORT=5435
DATABASE_URL=postgresql://eskista:eskista_dev_pw@localhost:5435/eskista?schema=public

# ── Cache (Docker Redis) ───────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL_MS=30000

# ── Better Auth ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=REPLACE_ME_WITH_openssl_rand_base64_48_output_here
BETTER_AUTH_URL=http://localhost:3000

# ── Telegram Mini App ──────────────────────────────────────────────────────
# From @BotFather. The Mini App must belong to this exact bot.
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# ── Social OAuth (reserve path; leave blank to disable) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Rate limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ── File storage ───────────────────────────────────────────────────────────
# Photos and documents live on Cloudinary. Leave STORAGE_DRIVER unset: it becomes
# `cloudinary` once the three credentials below are filled in, and falls back to local
# disk (development only) while they are blank. Production refuses local disk.
# Moving existing local files across: pnpm storage:migrate
STORAGE_DRIVER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Server-side only. Never expose it to the frontend.
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=eskista-dev
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/api/v1/files
STORAGE_MAX_FILE_SIZE_BYTES=10485760
